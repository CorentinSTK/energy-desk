# Copy to apps/web/.env.local (gitignored). In Vercel, set the same names in
# Project → Settings → Environment Variables (Production and Preview).

# Read-only Postgres URL for the `web_reader` role (ADR 0005): Supabase → Connect → "Transaction
# pooler" URI, with user web_reader.<project-ref> and the password set in the SQL editor.
DATABASE_URL_READONLY=
