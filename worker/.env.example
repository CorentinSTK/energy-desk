# Copy to worker/.env (gitignored) and fill in. Never commit real values.
# In CI, the same names are set as GitHub Actions secrets.

# Postgres URL of the database owner, for migrations and ingestion (worker only, never the website).
# Supabase → Connect → "Session pooler" URI, with the database password filled in.
DATABASE_URL=

# The site's read-only role (web_reader), for the health check only (python -m worker.health):
# the same value as DATABASE_URL_READONLY in Vercel. Optional locally.
DATABASE_URL_READONLY=

# Only for local database tests: a superuser URL on a disposable server, e.g.
# TEST_DATABASE_URL=postgresql://postgres@localhost:54329/postgres

# EIA API v2 key — https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# FRED API key — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# GIE key (one key for AGSI+ and ALSI, sent as the x-key header) — https://agsi.gie.eu/account
GIE_API_KEY=
# ENTSO-E Transparency security token — requested by email to transparency@entsoe.eu
ENTSOE_API_TOKEN=
