# Copy to worker/.env (gitignored) and fill in. Never commit real values.
# In CI, the same names are set as GitHub Actions secrets.

# EIA API v2 key — https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# FRED API key — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# GIE key (one key for AGSI+ and ALSI, sent as the x-key header) — https://agsi.gie.eu/account
GIE_API_KEY=
# ENTSO-E Transparency security token — requested by email to transparency@entsoe.eu
ENTSOE_API_TOKEN=
